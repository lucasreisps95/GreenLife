rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwnerOfDriver(driverId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/drivers/$(driverId))
        && get(/databases/$(database)/documents/drivers/$(driverId)).data.ownerUid == request.auth.uid;
    }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // drivers/{driverId} — one doc per driver, created the first time that
    // name is used on a device. ownerUid pins it to that device's anonymous
    // auth uid so a different device can't hijack an existing driver name.
    // Drivers never need to read this doc directly (only claim/refresh it via
    // write) — only the admin dashboard reads it, to list driver names.
    match /drivers/{driverId} {
      // Owner chose a no-login dashboard. This makes driver names and dashboard
      // data readable by anyone who knows the public dashboard URL.
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isOwnerOfDriver(driverId) || isAdmin();
      allow delete: if false;

      // drivers/{driverId}/days/{date} — one doc per day of sales for that driver.
      match /days/{dateId} {
        allow read: if true;
        allow write: if isOwnerOfDriver(driverId);
      }
    }

    // Shared menu and owner-managed driver display labels. Anyone may read the
    // current catalog, but only the authenticated owner can change it.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // admins/{uid} — one doc per owner/admin account, created manually in the
    // Firebase console (Firestore tab) after the owner signs in once via
    // admin.html with email/password. Doc content doesn't matter, only existence.
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
